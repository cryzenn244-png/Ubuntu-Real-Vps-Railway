# Set these in Railway Variables, not in source control.
USERNAME=miracle
PASSWORD=replace-with-a-long-random-secret-at-least-12-characters
# Optional independent secrets:
# WEB_USERNAME=miracle
# WEB_PASSWORD=replace-with-a-different-long-random-secret
# VNC_PASSWORD=classic-vnc-password
VNC_GEOMETRY=1440x900
VNC_DEPTH=24
DATA_DIR=/data
MODE=railway
# Railway provides PORT automatically; do not hard-code it in Railway.
