[Unit]
Description=Miracle Cloud VM runtime initialization
After=local-fs.target
Before=miracle-vnc.service miracle-novnc.service miracle-health.service miracle-nginx.service

[Service]
Type=oneshot
EnvironmentFile=/run/miracle/environment
ExecStart=/opt/miracle/scripts/runtime-setup.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
