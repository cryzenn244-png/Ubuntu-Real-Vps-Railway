[Unit]
Description=Miracle Cloud VM TigerVNC desktop
Requires=miracle-setup.service
After=miracle-setup.service network.target

[Service]
Type=simple
EnvironmentFile=/run/miracle/environment
ExecStart=/opt/miracle/scripts/start-vnc.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
