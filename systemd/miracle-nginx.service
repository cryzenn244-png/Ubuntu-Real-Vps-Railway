[Unit]
Description=Miracle Cloud VM authenticated browser gateway
Requires=miracle-setup.service miracle-health.service miracle-novnc.service
After=miracle-setup.service miracle-health.service miracle-novnc.service

[Service]
Type=simple
EnvironmentFile=/run/miracle/environment
ExecStart=/usr/sbin/nginx -g "daemon off;"
ExecReload=/usr/sbin/nginx -s reload
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
